configuration {
    modi:                       "apps:~/.config/rofi/scripts/apps.sh,run";
    show-icons:                 true;
    sorting-method:             "fzf";

    /* Atajos de teclado por posición: Ctrl+1..5 selecciona/lanza la app en esa fila */
    kb-select-1: "Control+1";
    kb-select-2: "Control+2";
    kb-select-3: "Control+3";
    kb-select-4: "Control+4";
    kb-select-5: "Control+5";
}

* {
    bg:            #0d1117ee;
    bg-alt:        #161b22;
    fg:            #c9d1d9;
    fg-alt:        #6e7681;
    accent:        #58a6ff;
    selected-bg:   #1f6feb33;
    border-color:  #58a6ff;
}

window {
    width:              480px;
    location:           center;
    anchor:             center;
    border-radius:      2px;   /* esquinas redondeadas, sin picom */
    border:             1px;
    border-color:       @border-color;
    background-color:   @bg;
    padding:            12px;
}

mainbox {
    children:           [ inputbar, listview ];
    spacing:             10px;
    background-color:    transparent;
}

inputbar {
    background-color:   @bg-alt;
    border-radius:       10px;
    padding:             10px 12px;
    children:            [ prompt, entry ];
}

prompt {
    text-color:  @accent;
    font:        "JetBrainsMono Nerd Font Bold 11";
}

entry {
    text-color:        @fg;
    placeholder:       " Buscar aplicación...";
    placeholder-color: @fg-alt;
}

/* --- Lista: 1 sola columna, 5 items fijos --- */
listview {
    columns:            1;
    lines:              5;
    spacing:             6px;
    fixed-height:        true;
    background-color:    transparent;
}

element {
    padding:             8px 10px;
    border-radius:       10px;
}

/* Cubrimos TODOS los estados explícitamente para que no se filtre
   el tema por defecto de rofi (el fondo crema que viste) */
element normal.normal,
element normal.urgent,
element normal.active,
element alternate.normal,
element alternate.urgent,
element alternate.active {
    background-color:    transparent;
    text-color:           @fg;
    border:               0px;
}

element selected.normal,
element selected.urgent,
element selected.active {
    background-color:    @selected-bg;
    text-color:           @accent;
    border:               1px;
    border-color:         @accent;
    border-radius:        10px;
}

element-icon {
    size:      22px;
    padding:   0 10px 0 0;
}

element-text {
    vertical-align:  0.5;
}
